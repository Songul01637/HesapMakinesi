<?xml version="1.0" encoding="utf-8" ?>

<!-- Standart hesap makinesi sayfası -->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HesapMakine.Pages.StandardPage"
    Title="Standart"
    BackgroundColor="{AppThemeBinding Light=#F3F4FA, Dark=#101426}">

	<Grid Padding="22"
          RowDefinitions="Auto,Auto,Auto,*,Auto"
          RowSpacing="8">

		<Label Grid.Row="0"
               Text="Standart Hesap Makinesi"
               TextColor="{AppThemeBinding Light=#24243A, Dark=White}"
               FontSize="23"
               FontAttributes="Bold"
               VerticalOptions="Center"/>

		<Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2239}"
                Stroke="{AppThemeBinding Light=#D9DCE8, Dark=#303957}"
                StrokeThickness="1"
                Padding="18"
                HeightRequest="105"
                StrokeShape="RoundRectangle 22">

			<VerticalStackLayout Spacing="8"
                                 VerticalOptions="Center">

				<Label Text="İŞLEM / SONUÇ"
                       TextColor="{AppThemeBinding Light=#77778D, Dark=#9299B2}"
                       FontSize="11"
                       CharacterSpacing="2"/>

				<Label x:Name="DisplayLabel"
                       Text="0"
                       TextColor="{AppThemeBinding Light=#24243A, Dark=White}"
                       FontSize="30"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="End"
                       LineBreakMode="TailTruncation"/>
			</VerticalStackLayout>
		</Border>

		<Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B2239}"
                Stroke="{AppThemeBinding Light=#D9DCE8, Dark=#303957}"
                StrokeThickness="1"
                Padding="14"
                HeightRequest="60"
                StrokeShape="RoundRectangle 16">

			<VerticalStackLayout Spacing="5">

				<Label Text="İŞLEM GEÇMİŞİ"
                       TextColor="{AppThemeBinding Light=#7655D9, Dark=#A78BFA}"
                       FontSize="10"
                       FontAttributes="Bold"/>

				<Label x:Name="HistoryLabel"
                       Text="Henüz işlem yapılmadı"
                       TextColor="{AppThemeBinding Light=#77778D, Dark=#9299B2}"
                       FontSize="12"
                       LineBreakMode="TailTruncation"/>
			</VerticalStackLayout>
		</Border>

		<Grid Grid.Row="3"
              ColumnDefinitions="*,*,*,*"
              RowDefinitions="*,*,*,*,*,*"
              ColumnSpacing="9"
              RowSpacing="7"
              VerticalOptions="Fill">

			<!-- Birinci satır -->
			<Button Text="AC" Grid.Row="0" Grid.Column="0"
                    Clicked="OnClearClicked"
                    BackgroundColor="{AppThemeBinding Light=#E8E3F7, Dark=#34304F}"
                    TextColor="{AppThemeBinding Light=#6045B5, Dark=#C4B5FD}"
                    FontAttributes="Bold"/>

			<Button Text="⌫" Grid.Row="0" Grid.Column="1"
                    Clicked="OnBackspaceClicked"
                    BackgroundColor="{AppThemeBinding Light=#E8E3F7, Dark=#34304F}"
                    TextColor="{AppThemeBinding Light=#6045B5, Dark=#C4B5FD}"/>

			<Button Text="(" Grid.Row="0" Grid.Column="2"
                    Clicked="OnParenthesisClicked"
                    BackgroundColor="{AppThemeBinding Light=#E8E3F7, Dark=#34304F}"
                    TextColor="{AppThemeBinding Light=#6045B5, Dark=#C4B5FD}"/>

			<Button Text=")" Grid.Row="0" Grid.Column="3"
                    Clicked="OnParenthesisClicked"
                    BackgroundColor="{AppThemeBinding Light=#E8E3F7, Dark=#34304F}"
                    TextColor="{AppThemeBinding Light=#6045B5, Dark=#C4B5FD}"/>

			<!-- İkinci satır -->
			<Button Text="7" Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked"/>

			<Button Text="8" Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked"/>

			<Button Text="9" Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked"/>

			<Button Text="÷" Grid.Row="1" Grid.Column="3"
                    Style="{StaticResource OperatorButtonStyle}"
                    Clicked="OnOperatorClicked"/>

			<!-- Üçüncü satır -->
			<Button Text="4" Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked"/>

			<Button Text="5" Grid.Row="2" Grid.Column="1"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked"/>

			<Button Text="6" Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked"/>

			<Button Text="×" Grid.Row="2" Grid.Column="3"
                    Style="{StaticResource OperatorButtonStyle}"
                    Clicked="OnOperatorClicked"/>

			<!-- Dördüncü satır -->
			<Button Text="1" Grid.Row="3" Grid.Column="0"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked"/>

			<Button Text="2" Grid.Row="3" Grid.Column="1"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked"/>

			<Button Text="3" Grid.Row="3" Grid.Column="2"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked"/>

			<Button Text="-" Grid.Row="3" Grid.Column="3"
                    Style="{StaticResource OperatorButtonStyle}"
                    Clicked="OnOperatorClicked"/>

			<!-- Beşinci satır -->
			<Button Text="+/-" Grid.Row="4" Grid.Column="0"
                    Clicked="OnSignClicked"
                    BackgroundColor="{AppThemeBinding Light=#E8E3F7, Dark=#34304F}"
                    TextColor="{AppThemeBinding Light=#6045B5, Dark=#C4B5FD}"/>

			<Button Text="0" Grid.Row="4" Grid.Column="1"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked"/>

			<Button Text="," Grid.Row="4" Grid.Column="2"
                    Clicked="OnDecimalClicked"
                    BackgroundColor="{AppThemeBinding Light=#E8E3F7, Dark=#34304F}"
                    TextColor="{AppThemeBinding Light=#6045B5, Dark=#C4B5FD}"/>

			<Button Text="+" Grid.Row="4" Grid.Column="3"
                    Style="{StaticResource OperatorButtonStyle}"
                    Clicked="OnOperatorClicked"/>

			<!-- Altıncı satır -->
			<Button Text="%" Grid.Row="5" Grid.Column="0"
                    Clicked="OnPercentClicked"
                    BackgroundColor="{AppThemeBinding Light=#E8E3F7, Dark=#34304F}"
                    TextColor="{AppThemeBinding Light=#6045B5, Dark=#C4B5FD}"/>

			<Button Text="=" Grid.Row="5" Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource EqualButtonStyle}"
                    Clicked="OnEqualClicked"
                    FontAttributes="Bold"/>
		</Grid>

		<Button Grid.Row="4"
                Text="🔬  BİLİMSEL HESAP MAKİNESİ"
                Clicked="OnScientificClicked"
                BackgroundColor="{AppThemeBinding Light=#E8E3F7, Dark=#242D49}"
                TextColor="{AppThemeBinding Light=#6045B5, Dark=#C4B5FD}"
                BorderColor="{AppThemeBinding Light=#C9BCEB, Dark=#51418D}"
                BorderWidth="1"
                CornerRadius="16"
                HeightRequest="45"
                FontAttributes="Bold"
                FontSize="13"/>
	</Grid>
</ContentPage>
